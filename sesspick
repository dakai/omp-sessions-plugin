#!/usr/bin/python3
"""sesspick: list all omp/pi sessions for fzf, print '<cwd>\\t<path>' of the pick.

Usage:
    sesspick [--query STR] [--preview ID]   # ID = session id prefix
    sesspick [--grep PATTERN]               # search user+assistant text
    sesspick --list                         # TSV to stdout, no fzf

List order: last real conversation activity first (content timestamps,
never filesystem mtime — mtime lies after any rename append).

shortcut: content search covers user+assistant text only (tool output
excluded); add a role filter here if tool output ever needs searching.

Review pane: fzf --preview 'sesspick --preview {id}' shows the session's
last user/assistant turns. The {id} is the trailing short-id field.
"""
import json
import os
import re
import subprocess
import sys
from datetime import datetime

SESS_ROOT = os.path.join(
    os.environ.get("PI_CODING_AGENT_DIR", os.path.expanduser("~/.omp/agent")),
    "sessions",
)


def msg_text(msg):
    if isinstance(msg, str):
        return msg
    if not isinstance(msg, dict):
        return ""
    c = msg.get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return " ".join(
            x if isinstance(x, str) else (x.get("text", "") if isinstance(x, dict) else "")
            for x in c
        )
    return ""


def compile_pattern(q):
    try:
        return re.compile(q, re.I)
    except re.error:
        return re.compile(re.escape(q), re.I)


def read_session(path, project, pattern=None):
    sid = cwd = created = header_title = ""
    name = None
    first_user = ""
    turns = []  # (role, text) user/assistant only, in file order
    hits = []  # (role, snippet) around each match, for row/preview
    hit_count = 0
    msg_count = 0
    last_activity = 0
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return None
    with fh:
        header_seen = False
        for line in fh:
            if not line.strip():
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if not isinstance(e, dict):
                continue
            if not header_seen:
                if e.get("type") != "session":
                    continue  # line 0 is the {"type":"title"} cache sidecar
                header_seen = True
                sid = e.get("id", "") or ""
                cwd = e.get("cwd", "") or ""
                created = e.get("timestamp", "") or ""
                header_title = e.get("title", "") or ""
                continue
            if e.get("type") == "session_info" and isinstance(e.get("name"), str):
                name = e["name"].strip() or None
            elif e.get("type") == "message":
                msg_count += 1
                m = e.get("message")
                if not isinstance(m, dict):
                    continue
                ts = e.get("timestamp", "")
                try:
                    t = datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
                    last_activity = max(last_activity, t)
                except ValueError:
                    pass
                role = m.get("role")
                if role in ("user", "assistant"):
                    text = " ".join(msg_text(m).split())
                    if text:
                        turns.append((role, text))
                        if pattern is not None:
                            for mo in pattern.finditer(text):
                                hit_count += 1
                                if len(hits) < 40:
                                    hits.append(
                                        (role, text[max(0, mo.start() - 60): mo.end() + 60])
                                    )
                        if role == "user" and not first_user:
                            first_user = text
    if not sid:
        return None
    effective = name or header_title.strip() or None
    display = effective or (first_user[:60] if first_user else "(untitled)")
    try:
        created_ts = datetime.fromisoformat(created.replace("Z", "+00:00")).timestamp()
    except ValueError:
        created_ts = 0
    return {
        "id": sid,
        "cwd": cwd,
        "activity": last_activity or created_ts,
        "display": display,
        "project": project,
        "path": path,
        "turns": turns,
        "hits": hits,
        "hit_count": hit_count,
        "msg_count": msg_count,
    }


def scan(pattern=None):
    rows = []
    try:
        projects = os.listdir(SESS_ROOT)
    except OSError:
        return rows
    for proj in projects:
        d = os.path.join(SESS_ROOT, proj)
        if not os.path.isdir(d):
            continue
        for f in os.listdir(d):
            if f.endswith(".jsonl"):
                r = read_session(os.path.join(d, f), proj, pattern)
                if r:
                    rows.append(r)
    if pattern is not None:
        # Title matches count too: `docker` should find a session named after it.
        rows = [r for r in rows if r["hit_count"] or pattern.search(r["display"])]
    rows.sort(key=lambda r: r["activity"], reverse=True)
    return rows


def stamp(ts):
    d = datetime.fromtimestamp(ts).astimezone()
    return d.strftime("%m%d %H:%M")


def row_line(r, pattern=None):
    proj = r["project"].lstrip("-").replace("-", "/")
    head = f"{stamp(r['activity'])}｜{r['display']}"
    if pattern is None:
        return f"{head}\t[{proj}]\t{r['id'][:8]}"
    snip = f" ×{r['hit_count']} …{r['hits'][0][1]}…" if r["hits"] else ""
    return f"{head}\t[{proj}]{snip}\t{r['id'][:8]}"


def main(argv):
    grep = None
    if argv[:1] == ["--grep"]:
        grep = argv[1] if len(argv) > 1 else ""
        argv = argv[2:]
    pattern = compile_pattern(grep) if grep else None
    if argv[:1] == ["--preview"]:
        want = (argv[1] if len(argv) > 1 else "").lower()
        # fzf runs the preview through a shell, so the pattern travels by env.
        pattern = compile_pattern(os.environ["SESSPICK_GREP"]) if os.environ.get("SESSPICK_GREP") else None
        for r in scan(pattern):
            if r["id"].lower().startswith(want):
                print(f"{r['display']}\n{r['cwd']}\n{r['path']}")
                if pattern is not None:
                    print(f"\n{r['hit_count']} content matches\n")
                    for role, snip in r["hits"]:
                        print(f"[{'YOU' if role == 'user' else 'OMP'}] …{snip}…")
                        print()
                else:
                    print()
                    for role, text in r["turns"][-12:]:
                        tag = "YOU" if role == "user" else "OMP"
                        print(f"[{tag}] {text[:500]}")
                        print()
                return 0
        return 1
    rows = scan(pattern)
    if pattern is not None and not rows:
        print(f"sesspick: no session content matches {grep!r}", file=sys.stderr)
        return 1
    if argv[:1] == ["--list"]:
        for r in rows:
            print(f"{row_line(r, pattern)}\t{r['cwd']}\t{r['path']}")
        return 0
    query = ""
    if argv[:1] == ["--query"]:
        query = argv[1] if len(argv) > 1 else ""
    me = os.path.realpath(__file__)
    fzf = [
        "/usr/bin/fzf",
        "--prompt=sess> ",
        "--with-nth=1,2,3",
        "--delimiter=\t",
        "--preview",
        f"{me} --preview {{3}}",
        "--preview-window=right:55%:wrap",
        "--bind=esc:cancel",
    ]
    if query:
        fzf.append(f"--query={query}")
    p = subprocess.run(
        fzf,
        input="\n".join(row_line(r, pattern) + f"\t{r['cwd']}\t{r['path']}" for r in rows),
        text=True,
        capture_output=True,
        env=dict(os.environ, **({"SESSPICK_GREP": grep} if grep else {})),
    )
    if p.returncode != 0 or not p.stdout.strip():
        return 1
    fields = p.stdout.rstrip("\n").split("\t")
    # print '<cwd>\t<path>' for the shell wrapper to cd + resume
    print(f"{fields[-2]}\t{fields[-1]}")
    return 0

if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.stderr.close()
        sys.exit(0)
